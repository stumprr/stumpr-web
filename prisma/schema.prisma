generator client {
  provider               = "prisma-client"
  output                 = "../src/lib/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

generator zero {
  provider = "prisma-zero"
  output   = "../src/lib/zero"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id                     String        @id
  orgId                  String
  org                    Organization  @relation(fields: [orgId], references: [id])
  userId                 String?       @unique
  user                   User?         @relation(fields: [userId], references: [id])
  name                   String
  role                   String
  image                  String?
  createdAt              DateTime      @default(now())
  potmMatches            Match[]       @relation("PlayerOfTheMatch")
  teamMemberships        TeamPlayer[]
  matchSelections        MatchPlayer[]
  battingBalls           Ball[]        @relation("BallBatter")
  nonStrikerBalls        Ball[]        @relation("BallNonStriker")
  bowlingBalls           Ball[]        @relation("BallBowler")
  fieldingBalls          Ball[]        @relation("BallFielder")
  secondaryFieldingBalls Ball[]        @relation("BallSecondaryFielder")
  dismissedBalls         Ball[]        @relation("BallDismissedPlayer")

  @@unique([id, orgId])
  @@index([orgId])
  @@map("players")
}

model Team {
  id             String        @id
  orgId          String
  org            Organization  @relation(fields: [orgId], references: [id])
  name           String
  slug           String
  image          String?
  createdAt      DateTime      @default(now())
  roster         TeamPlayer[]
  matchTeamA     Match[]       @relation("MatchTeamA")
  matchTeamB     Match[]       @relation("MatchTeamB")
  tossWonMatches Match[]       @relation("MatchTossWinner")
  wonMatches     Match[]       @relation("MatchWinner")
  battingInnings Inning[]      @relation("BattingTeam")
  bowlingInnings Inning[]      @relation("BowlingTeam")
  matchPlayers   MatchPlayer[]

  @@unique([id, orgId])
  @@unique([orgId, slug])
  @@index([orgId])
  @@map("teams")
}

model TeamPlayer {
  id        String   @id
  orgId     String
  teamId    String
  team      Team     @relation(fields: [teamId, orgId], references: [id, orgId])
  playerId  String
  player    Player   @relation(fields: [playerId, orgId], references: [id, orgId])
  createdAt DateTime @default(now())

  @@unique([orgId, teamId, playerId])
  @@index([orgId, playerId])
  @@index([orgId, teamId])
  @@map("team_players")
}
