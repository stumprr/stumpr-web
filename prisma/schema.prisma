generator client {
  provider               = "prisma-client"
  output                 = "../src/lib/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

generator zero {
  provider = "prisma-zero"
  output   = "../src/lib/zero"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth", "org"]
}
