model Match {
  id                 String        @id
  orgId              String
  org                Organization  @relation(fields: [orgId], references: [id])
  number             Int
  format             MATCH_FORMAT  @default(LIMITED_OVERS)
  status             MATCH_STATUS  @default(SCHEDULED)
  overs              Int
  teamAId            String
  teamA              Team          @relation("MatchTeamA", fields: [teamAId, orgId], references: [id, orgId])
  teamBId            String
  teamB              Team          @relation("MatchTeamB", fields: [teamBId, orgId], references: [id, orgId])
  tossWinnerTeamId   String
  tossWinnerTeam     Team          @relation("MatchTossWinner", fields: [tossWinnerTeamId, orgId], references: [id, orgId])
  tossDecision       TOSS_DECISION
  winnerTeamId       String?
  winnerTeam         Team?         @relation("MatchWinner", fields: [winnerTeamId, orgId], references: [id, orgId])
  result             MATCH_RESULT?
  winMarginRuns      Int?
  winMarginWickets   Int?
  playerOfTheMatchId String?
  playerOfTheMatch   Player?       @relation("PlayerOfTheMatch", fields: [playerOfTheMatchId, orgId], references: [id, orgId])
  createdAt          DateTime      @default(now())
  innings            Inning[]
  players            MatchPlayer[]

  @@unique([id, orgId])
  @@index([orgId, teamAId])
  @@index([orgId, teamBId])
  @@map("matches")
}

model MatchPlayer {
  id       String @id
  orgId    String
  matchId  String
  match    Match  @relation(fields: [matchId, orgId], references: [id, orgId])
  teamId   String
  team     Team   @relation(fields: [teamId, orgId], references: [id, orgId])
  playerId String
  player   Player @relation(fields: [playerId, orgId], references: [id, orgId])

  @@unique([orgId, matchId, teamId, playerId])
  @@index([orgId, matchId])
  @@index([orgId, teamId])
  @@index([orgId, playerId])
  @@map("match_players")
}

model Inning {
  id            String        @id
  orgId         String
  org           Organization  @relation(fields: [orgId], references: [id])
  matchId       String
  match         Match         @relation(fields: [matchId, orgId], references: [id, orgId])
  inningNumber  Int
  status        INNING_STATUS @default(NOT_STARTED)
  battingTeamId String
  battingTeam   Team          @relation("BattingTeam", fields: [battingTeamId, orgId], references: [id, orgId])
  bowlingTeamId String
  bowlingTeam   Team          @relation("BowlingTeam", fields: [bowlingTeamId, orgId], references: [id, orgId])
  oversLimit    Int?
  targetRuns    Int?
  createdAt     DateTime      @default(now())
  balls         Ball[]

  @@unique([id, orgId])
  @@unique([matchId, inningNumber])
  @@index([orgId, matchId, status])
  @@index([orgId, battingTeamId])
  @@index([orgId, bowlingTeamId])
  @@map("innings")
}

model Ball {
  id                 String          @id
  orgId              String
  org                Organization    @relation(fields: [orgId], references: [id])
  inningId           String
  inning             Inning          @relation(fields: [inningId, orgId], references: [id, orgId])
  sequence           Int
  batterId           String
  batter             Player          @relation("BallBatter", fields: [batterId, orgId], references: [id, orgId])
  bowlerId           String
  bowler             Player          @relation("BallBowler", fields: [bowlerId, orgId], references: [id, orgId])
  nonStrikerId       String
  nonStriker         Player          @relation("BallNonStriker", fields: [nonStrikerId, orgId], references: [id, orgId])
  fielderId          String?
  fielder            Player?         @relation("BallFielder", fields: [fielderId, orgId], references: [id, orgId])
  secondaryFielderId String?
  secondaryFielder   Player?         @relation("BallSecondaryFielder", fields: [secondaryFielderId, orgId], references: [id, orgId])
  dismissedPlayerId  String?
  dismissedPlayer    Player?         @relation("BallDismissedPlayer", fields: [dismissedPlayerId, orgId], references: [id, orgId])
  dismissalKind      DISMISSAL_KIND?
  runsOffBat         Int             @default(0)
  wides              Int             @default(0)
  noBalls            Int             @default(0)
  byes               Int             @default(0)
  legByes            Int             @default(0)
  createdAt          DateTime        @default(now())

  @@unique([id, orgId])
  @@unique([inningId, sequence])
  @@index([orgId, inningId, sequence])
  @@index([orgId, batterId])
  @@index([orgId, bowlerId])
  @@index([orgId, dismissedPlayerId])
  @@map("balls")
}
